	<dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>IconDark</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>IconDark</string>
			</dict>
			<key>IconLight</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>IconLight</string>
			</dict>
		</dict>
